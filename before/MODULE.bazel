# Consumer setup mirrors modules/zenoh-c/<ver>/overlay/tests/MODULE.bazel:
# zenoh-c registers its Rust/LLVM toolchains as dev_dependency, so the root
# module has to register them itself.

bazel_dep(name = "zenoh-c", version = "1.10.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_rs", version = "0.0.109")
bazel_dep(name = "llvm", version = "0.8.9")
bazel_dep(name = "rules_go", version = "0.65.0")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2021",
    version = "1.97.1",
)
use_repo(toolchains, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.8")
